# Copie para .env e ajuste com os valores reais do toolData_postgre.
#   cp .env.example .env
#
# Deve bater com o POSTGRES_USER/PASSWORD/DB do container postgres_db (toolData_postgre).
# NUNCA versionar o .env de verdade.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=postgres
POSTGRES_PORT=5432
